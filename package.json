{
  "name": "rap-lyrics-video-generator",
  "version": "1.0.0",
  "description": "Generate TikTok/YouTube videos with rap lyrics and term explanations using Remotion",
  "scripts": {
    "start": "npx remotion studio src/index.ts",
    "render": "npx remotion render src/index.ts LyricsVideo out/video.mp4",
    "upgrade": "npx remotion upgrade",
    "generate": "npx ts-node scripts/generate-video.ts",
    "fetch-cover": "npx ts-node scripts/fetch-cover.ts",
    "sync": "node scripts/sync_lyrics_node.js",
    "sync:interactive": "bash scripts/quick_sync.sh"
  },
  "dependencies": {
    "@remotion/cli": "4.0.242",
    "@remotion/bundler": "4.0.242",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "4.0.242",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "remotion",
    "video",
    "rap",
    "lyrics",
    "tiktok",
    "youtube"
  ]
}

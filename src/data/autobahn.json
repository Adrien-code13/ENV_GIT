          "category": "verlan"
        }
      ],
      "showExplanation": true
    },
    {
      "id": "line-006",
      "text": "Il veut s'faire ta piaule et ta recette (C'est réel)",
      "startTime": 9.8,
      "endTime": 11,
      "terms": [
        {
          "term": "piaule",
          "definition": "Chambre, appartement (argot)",
          "category": "argot"
        },
        {
          "term": "recette",
          "definition": "Argent, gains (argot)",
          "category": "argot"
        }
      ],
      "showExplanation": true
    },
    {
      "id": "line-007",
      "text": "J'ai pt'êt' un p'tit pet au casque, au lieu d'ouvrir on casse",
      "startTime": 11,

  "lyrics": [
    {
      "id": "line-001",
      "text": "J'commence couplet quand t'attendais l'refrain, yop (Arriba)",
      "startTime": 0,
      "endTime": 2.5,
      "terms": [],
      "showExplanation": false
    },
    {
      "id": "line-002",
      "text": "Là où c'est propre, nous on vient faire du sale (Tu-tu-tah)",
      "startTime": 2.5,
      "endTime": 5,
      "terms": [],
      "showExplanation": false
    },
    {
      "id": "line-003",
      "text": "Chez moi, on graille à même le sol",
      "startTime": 5,
      "endTime": 6,
      "terms": [
        {
          "term": "graille",
          "definition": "Manger (argot)",
          "category": "argot"
        }
      ],
      "showExplanation": true
    },
    {
      "id": "line-004",
      "text": "J'me fais les pec' en ramenant mon pompe à la salle",
      "startTime": 6,
      "endTime": 8,
      "terms": [],
      "showExplanation": false
    },
    {
      "id": "line-005",
      "text": "C'est pas ton pote, ce rasslah, il veut s'faire ta re-sœu",
      "startTime": 8,
      "endTime": 9.8,
      "terms": [
        {
          "term": "rasslah",
          "definition": "Gars louche, traître (argot)",
          "category": "argot"
        },
        {
          "term": "re-sœu",
